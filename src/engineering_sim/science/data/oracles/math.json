      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "Characteristic polynomial (2-lam)^2 - 1 = 0 -> lam = 2 +/- 1 = 3, 1 (eigenvector signs are arbitrary so only the eigenvalues are checked)"
      }
    },
    {
      "calc": "math.derivative",
      "inputs": {
        "expr": [
          "x**2 + 3*x"
        ],
        "at": 3
      },
      "expect": {
        "value": 9
