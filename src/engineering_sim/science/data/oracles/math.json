      },
      "source": {
        "kind": "hand",
        "derivation": "x = 5*cos30 = 5*0.8660254 = 4.330127; y = 5*sin30 = 2.5"
      }
    },
    {
      "calc": "math.vector_components",
      "inputs": {
        "x": 4.330127,
        "y": 2.5
      },
      "solve_for": [
        "r",
        "theta"
      ],
      "expect": {
        "r": 5,
        "theta": "30 deg"
      },
      "abs_tol": 1e-05,
      "source": {
        "kind": "hand",
        "derivation": "r = sqrt(4.330127^2 + 2.5^2) = 5; theta = atan2(2.5, 4.330127) = 30 deg"
      }
    },
    {
      "calc": "math.det2",
      "inputs": {
        "a": 1,
        "b": 2,
        "c": 3,
        "d": 4
      },
      "expect": {
        "det": -2
      },
      "source": {
        "kind": "hand",
        "derivation": "det = 1*4 - 2*3 = 4 - 6 = -2"
      }
    },
    {
      "calc": "math.det2",
      "inputs": {
        "det": -2,
        "b": 2,
        "c": 3,
        "d": 4
      },
      "solve_for": [
        "a"
      ],
      "expect": {
        "a": 1
      },
      "source": {
        "kind": "hand",
        "derivation": "a = (det + b*c)/d = (-2 + 6)/4 = 1"
      }
    },
    {
      "calc": "math.vector_ops",
      "inputs": {
        "a": [
          1,
          2,
          3
        ],
        "b": [
          4,
          5,
          6
        ]
      },
