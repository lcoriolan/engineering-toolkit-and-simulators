        "expr": [
          "x"
        ],
        "a": 0,
        "b": 2
      },
      "expect": {
        "definite": 2
      },
      "source": {
        "kind": "hand",
        "derivation": "integral_0^2 x dx = 2^2/2 = 2"
      }
    },
