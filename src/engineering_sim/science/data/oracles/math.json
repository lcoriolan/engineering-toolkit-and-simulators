        "kind": "hand",
        "derivation": "kappa = 1/0.25 = 4 m^-1"
      }
    },
    {
      "calc": "math.curvature",
      "inputs": {
        "kappa": "4 1/m"
      },
      "solve_for": [
        "R"
      ],
      "expect": {
        "R": "0.25 m"
      },
      "source": {
        "kind": "hand",
        "derivation": "R = 1/kappa = 0.25 m"
      }
    },
    {
      "calc": "math.triangle_centroid",
      "inputs": {
        "vertices": [
          [
            0,
            0
          ],
          [
            4,
            0
          ],
          [
            1,
            3
          ]
        ]
      },
      "expect": {
        "x_bar": "1.6666667 m",
        "y_bar": "1 m"
      },
      "source": {
        "kind": "hand",
        "derivation": "x_bar = (0+4+1)/3 = 5/3 = 1.666667; y_bar = (0+0+3)/3 = 1"
      }
    },
    {
      "calc": "math.vector_components",
      "inputs": {
        "r": 5,
        "theta": "30 deg"
      },
      "expect": {
        "x": 4.330127,
