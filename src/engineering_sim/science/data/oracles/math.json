      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "det = 1*4 - 2*3 = -2; trace = 1+4 = 5; inverse = (1/det)*[[4,-2],[-3,1]] = [[-2,1],[1.5,-0.5]]"
