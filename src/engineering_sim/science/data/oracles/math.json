{
  "section": "math",
  "cases": [
    {
      "calc": "math.circle_area",
      "inputs": {
        "r": "10 cm"
      },
      "expect": {
        "A": "0.03141593 m^2",
        "C": "0.6283185 m"
      },
      "source": {
        "kind": "hand",
        "derivation": "r = 0.10 m; A = pi*0.01 = 0.0314159 m^2; C = 2*pi*0.1 = 0.628319 m"
      }
    },
    {
      "calc": "math.circle_area",
      "inputs": {
        "A": "3.14159265 m^2"
      },
      "solve_for": [
        "r",
        "C"
      ],
      "expect": {
        "r": "1 m"
      },
      "source": {
        "kind": "hand",
        "derivation": "r = sqrt(A/pi) = sqrt(1) = 1 m"
      }
    },
    {
      "calc": "math.sphere_volume",
      "inputs": {
        "r": "1 m"
      },
      "expect": {
        "V": "4.188790 m^3",
        "A": "12.56637 m^2"
      },
      "source": {
        "kind": "hand",
        "derivation": "V = 4/3*pi = 4.188790; A = 4*pi = 12.56637"
      }
    },
    {
      "calc": "math.arc_length",
      "inputs": {
        "r": "0.5 m",
        "theta": "60 deg"
      },
      "expect": {
        "s": "0.5235988 m"
      },
      "source": {
        "kind": "hand",
        "derivation": "theta = pi/3 rad; s = 0.5*pi/3 = 0.5235988 m"
      }
    },
    {
      "calc": "math.arc_length",
      "inputs": {
        "r": "0.5 m",
        "s": "0.5235988 m"
      },
      "solve_for": [
        "theta"
      ],
      "expect": {
        "theta": "1.0471976 rad"
      },
      "source": {
        "kind": "hand",
        "derivation": "theta = s/r = 0.5235988/0.5 = 1.0471976 rad = 60 deg"
      }
    },
    {
      "calc": "math.curvature",
      "inputs": {
        "R": "250 mm"
      },
      "expect": {
        "kappa": "4 1/m"
      },
