      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "dot = 1*4+2*5+3*6 = 32; cross = (2*6-3*5, 3*4-1*6, 1*5-2*4) = (-3, 6, -3); |a| = sqrt(14) = 3.741657; |b| = sqrt(77) = 8.774964; angle = acos(32/(sqrt14*sqrt77)) = acos(0.9746318) = 0.225726 rad"
      }
    },
    {
