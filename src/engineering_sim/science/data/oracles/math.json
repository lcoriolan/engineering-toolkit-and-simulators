      "solve_for": [
        "b"
      ],
      "expect": {
        "b": 2
      },
      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "integral_0^b x dx = b^2/2 = 2 -> b = 2"
      }
    },
    {
      "calc": "math.laplace_transform",
      "inputs": {
        "expr": [
          "exp(-3*t)"
