      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "s = 2.13809, n = 8, se = s/sqrt(8) = 0.755929; t(0.975, 7) = 2.364624; margin = 2.364624*0.755929 = 1.787488; mean = 5"
      }
    },
    {
