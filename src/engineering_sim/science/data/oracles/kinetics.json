      "inputs": {
        "v1": "10 m/s",
        "v2": "0 m/s",
        "v1p": "2 m/s",
        "v2p": "8 m/s"
      },
      "expect": {
        "e": 0.6
      },
      "source": {
        "kind": "hand",
        "derivation": "e = (v2′ − v1′)/(v1 − v2) = (8 − 2)/(10 − 0) = 0.6"
      }
    },
    {
      "calc": "kinetics.impact_velocities",
      "inputs": {
        "m1": "2 kg",
        "m2": "3 kg",
        "v1": "10 m/s",
        "v2": "0 m/s",
        "e": 0.6
      },
      "expect": {
        "v1p": "0.4 m/s",
        "v2p": "6.4 m/s"
      },
      "source": {
        "kind": "hand",
        "derivation": "v1′ = ((m1−em2)v1 + (1+e)m2 v2)/(m1+m2) = ((2−1.8)·10 + 0)/5 = 2/5 = 0.4 m/s; v2′ = ((1+e)m1 v1 + (m2−em1)v2)/(m1+m2) = (1.6·2·10 + 0)/5 = 32/5 = 6.4 m/s (check momentum 2·0.4 + 3·6.4 = 20 = 2·10)"
      }
    },
    {
