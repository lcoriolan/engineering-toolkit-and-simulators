      "source": {
        "kind": "hand",
        "derivation": "Solid sphere about a diameter: I_c = ⅖mr² = 0.4·5·0.04 = 0.08 kg·m²; with d = 0 the parallel axis adds nothing"
      }
    },
    {
      "calc": "kinetics.mass_moment_inertia",
      "inputs": {
        "solid": {
          "shape": "sphere",
          "m": 5,
          "r": 0.2
        },
        "d": "300 mm"
      },
      "expect": {
        "I_c": "0.08 kg*m^2",
        "I": "0.53 kg*m^2"
      },
      "source": {
        "kind": "hand",
        "derivation": "Parallel-axis theorem: I = I_c + md² = 0.08 + 5·0.3² = 0.08 + 0.45 = 0.53 kg·m²"
      }
    },
    {
