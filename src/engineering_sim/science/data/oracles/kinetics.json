    },
    {
      "calc": "kinetics.tsiolkovsky",
      "inputs": {
        "v_e": "3000 m/s",
        "m0": "1000 kg",
        "mf": "200 kg"
      },
      "expect": {
        "dv": "4828.31 m/s"
      },
      "source": {
        "kind": "hand",
        "derivation": "Δv = v_e·ln(m0/mf) = 3000·ln(5) = 3000·1.609438 = 4828.31 m/s"
      }
    },
    {
      "calc": "kinetics.tsiolkovsky",
      "inputs": {
        "dv": "4828.31 m/s",
        "v_e": "3000 m/s",
        "mf": "200 kg"
      },
      "solve_for": [
        "m0"
      ],
      "expect": {
        "m0": "1000 kg"
      },
      "source": {
        "kind": "hand",
        "derivation": "m0 = mf·exp(dv/v_e) = 200·exp(4828.31/3000) = 200·exp(1.609438) = 200·5 = 1000 kg"
