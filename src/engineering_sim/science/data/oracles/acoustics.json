        "A": "50 m^2"
      },
      "expect": {
        "T60": "1.61 s"
      },
      "source": {
        "kind": "hand",
        "derivation": "T60 = 0.161·500/50 = 0.161·10 = 1.61 s"
      }
    },
    {
      "calc": "acoustics.reverberation_sabine",
      "inputs": {
        "k_sabine": 0.161,
        "V": "500 m^3",
        "T60": "2.3 s"
      },
      "solve_for": [
        "A"
      ],
      "expect": {
        "A": "35.0 m^2"
      },
      "source": {
        "kind": "hand",
        "derivation": "A = 0.161·500/2.3 = 80.5/2.3 = 35.0 m²"
      }
    },
    {
      "calc": "acoustics.total_absorption",
      "inputs": {
        "surfaces": [
          [
            0.03,
            200.0
          ],
          [
            0.5,
            40.0
          ],
          [
            0.8,
            20.0
          ]
        ]
      },
      "expect": {
        "A": 42.0,
        "mean_alpha": 0.161538
      },
      "source": {
        "kind": "hand",
        "derivation": "A = 0.03·200 + 0.5·40 + 0.8·20 = 6 + 20 + 16 = 42 m²; ᾱ = 42/260 = 0.16154"
      }
    },
    {
      "calc": "acoustics.a_weighting",
      "inputs": {
        "f": 1000.0
      },
      "expect": {
        "A": 0.0
      },
      "abs_tol": 0.05,
      "source": {
        "kind": "hand",
        "derivation": "A(1 kHz) = 0 dB by definition of the A-weighting (rounded pole frequencies give ~0.0001 dB)"
      }
    },
    {
      "calc": "acoustics.a_weighting",
      "inputs": {
        "f": 100.0
      },
      "expect": {
        "A": -19.145
      },
      "rel_tol": 0.0005,
      "source": {
        "kind": "hand",
        "derivation": "R_A(100) = 12194²·100⁴/((100²+20.6²)(100²+12194²)√(100²+107.7²)√(100²+737.9²)) = 0.087650; 20 log10(R_A) = −21.145; A = −21.145 + 2 = −19.145 dB"
      }
    },
    {
      "calc": "acoustics.noise_dose",
      "inputs": {
        "standard": "OSHA",
        "levels": [
          90.0
        ],
        "durations": [
          8.0
        ]
      },
      "expect": {
        "exchange_rate": 5.0,
        "criterion": 90.0,
        "dose": 100.0,
        "twa": 90.0
      },
      "source": {
        "kind": "hand",
        "derivation": "T = 8/2^((90−90)/5) = 8 h; dose = 100·8/8 = 100 %; TWA = 90 + 5·log2(1) = 90 dB"
      }
    },
    {
      "calc": "acoustics.noise_dose",
      "inputs": {
        "standard": "NIOSH/ISO",
        "levels": [
          85.0
        ],
        "durations": [
          8.0
        ]
      },
      "expect": {
        "dose": 100.0,
        "twa": 85.0
      },
      "source": {
        "kind": "hand",
        "derivation": "NIOSH/ISO: T = 8/2^0 = 8 h; dose = 100 %; TWA = 85 dB"
      }
    },
    {
      "calc": "acoustics.noise_dose",
      "inputs": {
        "standard": "OSHA",
        "levels": [
          80.0,
          90.0
        ],
        "durations": [
          4.0,
          4.0
        ]
      },
      "expect": {
        "dose": 62.5,
        "twa": 86.6096
      },
      "source": {
        "kind": "hand",
        "derivation": "All levels are counted (no threshold): T(80) = 8/2^((80−90)/5) = 32 h, T(90) = 8 h; dose = 100(4/32 + 4/8) = 62.5 %; TWA = 90 + 5·log2(0.625) = 90 − 3.39036 = 86.6096 dB"
      }
    },
    {
      "calc": "acoustics.noise_dose",
      "inputs": {
        "standard": "OSHA",
        "levels": [
          95.0,
          85.0
        ],
        "durations": [
          4.0,
          4.0
        ]
      },
      "expect": {
        "dose": 125.0,
        "twa": 91.6096
      },
      "source": {
        "kind": "hand",
        "derivation": "T(95) = 8/2^1 = 4 h, T(85) = 8/2^-1 = 16 h; dose = 100(4/4 + 4/16) = 125 %; TWA = 90 + 5·log2(1.25) = 90 + 5·0.32193 = 91.610 dB"
      }
    }
  ]
}
