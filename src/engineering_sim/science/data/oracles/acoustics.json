{
  "section": "acoustics",
  "cases": [
    {
      "calc": "acoustics.spl",
      "inputs": {
        "p": "0.02 Pa",
        "p_ref": "20 uPa"
      },
      "expect": {
        "spl": 60.0
      },
      "source": {
        "kind": "hand",
        "derivation": "Lp = 20 log10(0.02/20e-6) = 20 log10(1000) = 20·3 = 60 dB"
      }
    },
    {
      "calc": "acoustics.spl",
      "inputs": {
        "spl": 80.0,
        "p_ref": "20 uPa"
      },
      "solve_for": [
        "p"
      ],
      "expect": {
        "p": "0.2 Pa"
      },
      "source": {
        "kind": "hand",
        "derivation": "p = p_ref·10^(Lp/20) = 20e-6·10^4 = 0.2 Pa"
      }
    },
    {
      "calc": "acoustics.power_level",
      "inputs": {
        "W": "5 mW",
        "W_ref": "1 pW"
      },
      "expect": {
        "Lw": 96.9897
      },
      "source": {
        "kind": "hand",
        "derivation": "Lw = 10 log10(5e-3/1e-12) = 10 log10(5e9) = 10·9.69897 = 96.990 dB"
      }
    },
    {
      "calc": "acoustics.intensity_level",
      "inputs": {
        "I": "1 uW/m^2",
        "I_ref": "1 pW/m^2"
      },
      "expect": {
        "Li": 60.0
      },
      "source": {
        "kind": "hand",
        "derivation": "Li = 10 log10(1e-6/1e-12) = 10 log10(1e6) = 60 dB"
      }
    },
    {
      "calc": "acoustics.pressure_intensity",
      "inputs": {
        "p": "0.1 Pa",
        "rho": 1.2,
        "c": "343 m/s"
      },
      "expect": {
        "I": "2.42954e-5 W/m^2"
      },
      "rel_tol": 0.0005,
      "source": {
        "kind": "hand",
        "derivation": "I = p²/(ρc) = 0.01/(1.2·343) = 0.01/411.6 = 2.4295e-5 W/m²"
      }
    },
    {
      "calc": "acoustics.add_levels",
      "inputs": {
        "levels": [
          80.0,
          80.0,
          75.0
        ]
      },
      "expect": {
        "L_total": 83.6478
      },
      "source": {
        "kind": "hand",
        "derivation": "L = 10 log10(10^8 + 10^8 + 10^7.5) = 10 log10(2.3162e8) = 10·8.36478 = 83.648 dB"
      }
    },
    {
      "calc": "acoustics.add_levels",
      "inputs": {
        "levels": [
          80.0,
          80.0
        ]
      },
      "expect": {
        "L_total": 83.0103
      },
      "source": {
        "kind": "hand",
        "derivation": "Two equal levels add 3 dB: 80 + 10 log10(2) = 80 + 3.0103 = 83.010 dB"
      }
    },
    {
      "calc": "acoustics.wave_speed",
      "inputs": {
        "f": "500 Hz",
        "lam": "686 mm"
      },
      "expect": {
        "c": "343 m/s"
      },
      "source": {
        "kind": "hand",
        "derivation": "c = f λ = 500·0.686 = 343 m/s"
      }
    },
    {
      "calc": "acoustics.wave_speed",
      "inputs": {
        "c": "343 m/s",
        "f": "1 kHz"
      },
      "solve_for": [
        "lam"
      ],
      "expect": {
        "lam": "0.343 m"
      },
      "source": {
        "kind": "hand",
        "derivation": "λ = c/f = 343/1000 = 0.343 m"
      }
    },
    {
      "calc": "acoustics.mass_law",
      "inputs": {
        "rho_s": "20 kg/m^2",
        "f": "1 kHz",
        "rho": 1.2,
        "c": "343 m/s"
      },
      "expect": {
        "TL": 43.6743
      },
      "rel_tol": 0.0005,
      "source": {
        "kind": "hand",
        "derivation": "x = π·1000·20/(1.2·343) = 152.65; TL = 10 log10(1 + 152.65²) = 10 log10(23302) = 43.674 dB"
      }
    },
    {
      "calc": "acoustics.noise_reduction",
      "inputs": {
        "L1": 95.0,
        "L2": 62.0
      },
      "expect": {
        "NR": 33.0
      },
      "source": {
        "kind": "hand",
        "derivation": "NR = 95 − 62 = 33 dB"
      }
    },
    {
      "calc": "acoustics.room_noise_reduction",
      "inputs": {
        "TL": 40.0,
        "A": "100 m^2",
        "S": "20 m^2"
      },
      "expect": {
        "NR": 46.9897
      },
      "source": {
        "kind": "hand",
        "derivation": "NR = 40 + 10 log10(100/20) = 40 + 10·0.69897 = 46.990 dB"
      }
    },
    {
      "calc": "acoustics.reverberation_sabine",
      "inputs": {
        "k_sabine": 0.161,
