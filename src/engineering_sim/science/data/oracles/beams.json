      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "Castigliano: U = integral_0^L (Px)^2/(2EI) dx = P^2 L^3/(6EI); delta = dU/dP = PL^3/(3EI) = 1.66667e-3 (equals the general solver)"
      }
    },
    {
