        "theta": "1.25e-3 rad",
        "M_max": "2 kN*m"
      },
      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "P=1000, L=2, EI=200e9·8e-6=1.6e6; delta = 1000·8/(3·1.6e6) = 1.66667e-3; theta = 1000·4/(2·1.6e6) = 1.25e-3; M_max = 1000·2 = 2000"
      }
    },
    {
