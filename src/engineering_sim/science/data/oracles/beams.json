      "rel_tol": 0.0001,
      "source": {
        "kind": "hand",
        "derivation": "Moment-area: tip slope = area of M/EI diagram = (PL/EI)(L/2) = PL^2/(2EI) = 1.25e-3; tip deflection = first moment = (PL^2/2EI)(2L/3) = PL^3/(3EI) = 1.66667e-3 (equals cantilever_end_load and the general solver)"
      }
    },
    {
      "calc": "beams.castigliano_energy",
      "inputs": {
        "P": "1000 N",
        "L": "2 m",
        "E": "200 GPa",
        "I": "8e-6 m^4"
