{
  "section": "beams",
  "cases": [
    {
      "calc": "beams.cantilever_end_load",
      "inputs": {
        "P": "1 kN",
        "L": "2000 mm",
        "E": "200 GPa",
        "I": "8e-6 m^4"
      },
      "expect": {
