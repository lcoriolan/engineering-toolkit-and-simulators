        "kind": "hand",
        "derivation": "BMEP = 2π·2·250/2e-3 = 4π·250/0.002 = 1 570 796 Pa = 1.5708 MPa (four-stroke)"
      }
    },
    {
      "calc": "ic_engines.brake_mep",
      "inputs": {
        "T": "300 N*m",
        "V_d": "2.5 L",
        "n_rev": "two-stroke"
