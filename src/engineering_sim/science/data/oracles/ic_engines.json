{
  "section": "ic_engines",
  "cases": [
    {
      "calc": "ic_engines.displacement_volume",
      "inputs": {
        "B": "90 mm",
        "S": "85 mm",
        "N_cyl": 6
      },
      "expect": {
        "V_d": "5.4075e-4 m^3",
        "V_total": "3.2445e-3 m^3"
      },
      "source": {
        "kind": "hand",
        "derivation": "V_d = (π/4)·0.09²·0.085 = 0.785398·0.0006885 = 5.4075e-4 m³; V_total = 6·V_d = 3.2445e-3 m³"
      }
    },
    {
      "calc": "ic_engines.compression_ratio",
      "inputs": {
        "V_d": "500 cm^3",
        "V_c": "50 cm^3"
      },
      "expect": {
        "r": 11.0
      },
      "source": {
        "kind": "hand",
        "derivation": "r = 1 + 500/50 = 1 + 10 = 11"
      }
    },
    {
      "calc": "ic_engines.compression_ratio",
      "inputs": {
        "V_d": "5e-4 m^3",
        "r": 9.0
      },
      "solve_for": [
        "V_c"
      ],
      "expect": {
        "V_c": "6.25e-5 m^3"
      },
      "source": {
        "kind": "hand",
        "derivation": "V_c = V_d/(r − 1) = 5e-4/8 = 6.25e-5 m³"
      }
    },
    {
      "calc": "ic_engines.engine_power",
      "inputs": {
        "BP": "90 kW",
        "FP": "20 kW"
      },
      "expect": {
        "IP": "110 kW"
      },
      "source": {
        "kind": "hand",
        "derivation": "IP = BP + FP = 90 + 20 = 110 kW"
      }
    },
    {
      "calc": "ic_engines.mep",
