        "kind": "hand",
        "derivation": "IP = 800e3·2e-3·50/2 = 40 000 W = 40 kW (3000 rpm four-stroke)"
      }
    },
    {
      "calc": "ic_engines.indicated_power",
      "inputs": {
        "MEP": "800 kPa",
        "V_d": "2 L",
        "N": "50 1/s",
        "n_rev": "two-stroke"
      },
      "expect": {
        "IP": "80 kW"
      },
      "source": {
        "kind": "hand",
        "derivation": "IP = 800e3·2e-3·50/1 = 80 000 W = 80 kW (two-stroke, one power stroke per revolution)"
      }
    },
    {
      "calc": "ic_engines.brake_mep",
      "inputs": {
        "T": "250 N*m",
        "V_d": "2 L",
        "n_rev": "four-stroke"
