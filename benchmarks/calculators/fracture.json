      "equations": [],
      "procedure": {
        "python": "def _paris_cycles(v):\n    \"\"\"Cycles to failure under the Paris law with a constant geometry factor Y.\n\n    Closed form of N_f = integral_{a0}^{ac} da / (C (Y dsigma sqrt(pi a))^m) for m != 2 and m = 2.\n    \"\"\"\n    C, m, dsigma, Y = v['C'], v['m'], v['dsigma'], v['Y']\n    a0, ac = v['a0'], v['ac']\n    if ac <= a0:\n        raise MechError('ac (final crack length) must be greater than a0 (initial crack length)')\n    DKbase = Y * dsigma * math.sqrt(PI)\n    if abs(m - 2.0) < 1e-9:\n        Nf = math.log(ac / a0) / (C * DKbase ** 2)\n    else:\n        Nf = (ac ** (1 - m / 2) - a0 ** (1 - m / 2)) / (C * DKbase ** m * (1 - m / 2))\n    return {'N_f': Nf}\n",
        "source": "fracture.py",
        "line": 37
      },
      "outputs": [
        "N_f"
      ],
      "assumptions": [
        "Constant Y over the growth interval (closed form). For m = 2 the closed form is logarithmic; otherwise it is a power law. For a crack-length-dependent Y use paris_cycles_ya."
      ],
      "method_references": [
        "Integrated Paris law (constant geometry factor)"
      ],
      "synthetic_example": {
