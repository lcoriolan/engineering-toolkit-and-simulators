        {
          "name": "p",
          "unit": "m",
          "desc": "pitch",
          "lo": null,
          "hi": null,
          "label": null,
          "integer": false,
          "signed": false,
          "source": null,
          "kind": "scalar",
          "choices": null
        }
      ],
      "equations": [
        "T_R = F*d_m/2*(l + pi*f*d_m/cos(alpha))/(pi*d_m - f*l/cos(alpha))",
        "T_L = F*d_m/2*(pi*f*d_m/cos(alpha) - l)/(pi*d_m + f*l/cos(alpha))",
        "l = n_s*p",
        "lam = atan(l/(pi*d_m))"
      ],
      "procedure": null,
      "outputs": [
        "T_R",
        "T_L",
        "l",
        "lam"
      ],
      "assumptions": [
        "1/cos(\u03b1) is the secant wedge term (\u03b1 the flank half-angle; sec \u03b1 = 1 for square threads). Collar friction is separate \u2014 add the collar torque T_c to T_R and T_L for the total.",
        "T_L > 0 means self-locking against back-drive. Multi-start lead l = n_s\u00b7p."
      ],
      "method_references": [
        "Power screw torque with thread angle (Shigley eqs. 8-1/8-2 form, recalled)"
      ],
      "synthetic_example": {
        "F": 5000.0,
        "d_m": 0.032,
        "f": 0.15,
        "alpha": 0.0,
        "n_s": 1,
        "p": 0.006
