        {
          "name": "n_s",
          "unit": "",
          "desc": "number of thread starts",
          "lo": 1,
          "hi": null,
          "label": null,
          "integer": true,
          "signed": false,
          "source": null,
          "kind": "scalar",
          "choices": null
