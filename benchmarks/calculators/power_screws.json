          "kind": "scalar",
          "choices": null
        }
      ],
      "equations": [
        "e = l*(pi*d_m - f*l/cos(alpha))/(pi*d_m*(l + pi*f*d_m/cos(alpha)))",
        "n_lock = pi*f*d_m/(l*cos(alpha))"
      ],
      "procedure": null,
      "outputs": [
        "e",
        "n_lock"
      ],
      "assumptions": [
        "Thread-only efficiency e = F\u00b7l/(2\u03c0\u00b7T_R); collar friction lowers the overall efficiency below this. Self-locking (no back-drive) requires \u03c0\u00b7f\u00b7d_m > l\u00b7cos \u03b1, i.e. n_lock > 1, equivalently T_L > 0 in power_screw_torque."
      ],
      "method_references": [
        "Power screw efficiency; self-locking condition (recalled)"
      ],
      "synthetic_example": {
        "d_m": 0.032,
        "l": 0.006,
        "f": 0.15,
        "alpha": 0.0
