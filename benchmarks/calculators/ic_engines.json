      "procedure": {
        "python": "def _volumetric_efficiency(values):\n    \"\"\"Volumetric efficiency \u03b7_v = \u1e41_a / (\u03c1_a V_d N / n_rev) (V_d = total engine displacement).\"\"\"\n    n = _n_rev(values)\n    return {'eta_v': values['m_dot_a'] / (values['rho_a'] * values['V_d'] * values['N'] / n)}\n",
        "source": "ic_engines.py",
        "line": 52
      },
      "outputs": [
        "eta_v"
      ],
      "assumptions": [
        "\u03b7_v compares the actual inducted air to the ideal charge \u03c1_a V_d N/n_rev the swept volume could draw at intake conditions. V_d is the TOTAL displacement of all cylinders."
      ],
      "method_references": [
        "\u03b7_v = \u1e41_a / (\u03c1_a V_d N / n_rev)"
      ],
