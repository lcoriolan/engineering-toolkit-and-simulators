            "four-stroke"
          ]
        }
      ],
      "equations": [],
      "procedure": {
        "python": "def _brake_mep(values):\n    \"\"\"Brake mean effective pressure BMEP = 2\u03c0 n_rev T / V_d (V_d = total engine displacement).\"\"\"\n    return {'BMEP': 2.0 * PI * _n_rev(values) * values['T'] / values['V_d']}\n",
        "source": "ic_engines.py",
        "line": 47
      },
      "outputs": [
        "BMEP"
      ],
      "assumptions": [
        "BMEP = BP/(V_d N/n_rev) = 2\u03c0 n_rev T / V_d, so a four-stroke gives 4\u03c0 T/V_d and a two-stroke 2\u03c0 T/V_d. V_d is the TOTAL displacement of all cylinders."
      ],
      "method_references": [
        "BMEP from torque (recalled)"
      ],
      "synthetic_example": {
        "T": 250.0,
        "V_d": 0.002,
        "n_rev": "four-stroke"
      }
    },
