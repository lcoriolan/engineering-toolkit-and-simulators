      "procedure": {
        "python": "def _indicated_power(values):\n    \"\"\"Indicated power IP = MEP \u00b7 V_d \u00b7 N / n_rev (V_d = total engine displacement).\"\"\"\n    return {'IP': values['MEP'] * values['V_d'] * values['N'] / _n_rev(values)}\n",
        "source": "ic_engines.py",
        "line": 42
      },
      "outputs": [
        "IP"
      ],
      "assumptions": [
        "N in rev/s (3000 rpm = 50 rev/s); cycles per second are N/n_rev. V_d is the TOTAL displacement of all cylinders (multiply a per-cylinder swept volume by the cylinder count)."
      ],
      "method_references": [
        "IP = MEP \u00b7 V_d \u00b7 N / n_rev"
