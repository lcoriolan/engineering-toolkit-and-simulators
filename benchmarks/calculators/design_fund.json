        {
          "name": "rss_tol",
          "unit": "m",
          "desc": "root-sum-square tolerance (statistical)",
          "lo": null,
          "hi": null,
          "label": null,
          "integer": false,
          "signed": false,
          "source": null,
          "kind": "scalar",
          "choices": null
        }
      ],
      "equations": [],
      "procedure": {
        "python": "def _tolerance_stackup(values):\n    \"\"\"Worst-case and RSS (statistical) tolerance stack of dimensions [[nominal, +/-tol], ...].\"\"\"\n    parts = values['parts']\n    if not isinstance(parts, list) or not parts:\n        raise MechError('parts: give [[nominal, +/-tol], ...]')\n    total = worst_max = worst_min = rss2 = 0.0\n    for row in parts:\n        if len(row) != 2:\n            raise MechError('each part row must be [nominal, +/-tol]')\n        nom, tol = float(row[0]), float(row[1])\n        total += nom\n        worst_max += nom + tol\n        worst_min += nom - tol\n        rss2 += tol * tol\n    return {'total_nominal': total, 'worst_max': worst_max, 'worst_min': worst_min,\n            'rss_tol': math.sqrt(rss2)}\n",
        "source": "design_fund.py",
        "line": 35
      },
      "outputs": [
        "total_nominal",
        "worst_max",
        "worst_min",
        "rss_tol"
      ],
      "assumptions": [
        "Arithmetic (worst-case) stack adds all +/-tolerances; the RSS (root-sum-square) value assumes independent, normally distributed dimensions. The parts rows and the outputs are in m (enter any compatible length unit)."
      ],
      "method_references": [
        "Worst-case and root-sum-square tolerance accumulation"
      ],
      "synthetic_example": {
        "parts": [
          [
            10.0,
            0.1
          ],
          [
            20.0,
            0.2
          ],
          [
            5.0,
            0.05
          ]
        ]
      }
    },
