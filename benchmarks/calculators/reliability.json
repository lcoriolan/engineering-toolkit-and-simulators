      "equations": [],
      "procedure": {
        "python": "def _weibull_hazard(v):\n    \"\"\"Weibull hazard rate and pdf at time t: h(t) = (\u03b2/\u03b7)(t/\u03b7)^(\u03b2\u22121), f(t) = h(t)\u00b7R(t).\"\"\"\n    beta, eta, t = v['beta'], v['eta'], v['t']\n    if beta <= 0 or eta <= 0 or t < 0:\n        raise MechError('Weibull needs \u03b2 > 0, \u03b7 > 0 and t \u2265 0')\n    if t == 0.0:\n        # h(0) = 0 for \u03b2 > 1, = 1/\u03b7 for \u03b2 = 1, and is unbounded for \u03b2 < 1 (wear-in).\n        if beta < 1.0:\n            raise MechError('hazard rate is unbounded at t = 0 for \u03b2 < 1')\n        h = 0.0 if beta > 1.0 else 1.0 / eta\n        return {'h': h, 'f': h}\n    ratio = t / eta\n    h = (beta / eta) * ratio ** (beta - 1.0)\n    f = h * math.exp(-(ratio ** beta))\n    return {'h': h, 'f': f}\n",
        "source": "reliability.py",
        "line": 62
      },
      "outputs": [
        "h",
        "f"
      ],
      "assumptions": [
        "Two-parameter Weibull, t \u2265 0, \u03b2 > 0, \u03b7 > 0. h(t) is the instantaneous failure rate (increasing for \u03b2 > 1 wear-out, decreasing for \u03b2 < 1 wear-in, constant \u03b2 = 1)."
      ],
      "method_references": [
        "Weibull h(t) = (\u03b2/\u03b7)(t/\u03b7)^(\u03b2\u22121); f(t) = h(t)\u00b7R(t)"
      ],
      "synthetic_example": {
        "beta": 2.0,
        "eta": 1000.0,
        "t": 1000.0
      }
