      "equations": [],
      "procedure": {
        "python": "def _series(v):\n    \"\"\"Reliability of n independent components in series (system survives only if every component does).\"\"\"\n    rs = v['R_list']\n    if not isinstance(rs, (list, tuple)) or not rs:\n        raise MechError('R_list: give a JSON list of component reliabilities (each in [0, 1])')\n    rs = [float(r) for r in rs]\n    if any(not 0 <= r <= 1 for r in rs):\n        raise MechError('R_list: reliabilities must be in [0, 1]')\n    R = 1.0\n    for r in rs:\n        R *= r\n    return {'R_s': R}\n",
        "source": "reliability.py",
        "line": 87
      },
      "outputs": [
        "R_s"
      ],
      "assumptions": [
        "Independent components; the system survives only if every component survives, so R_s = R1\u00b7R2\u00b7\u2026\u00b7Rn. Series systems are only as good as their weakest link."
      ],
      "method_references": [
        "R_s = \u03a0 R_i for independent series components"
      ],
