        "x_bar",
        "y_bar",
        "T",
        "tau_direct",
        "tau_max",
        "x_crit",
        "y_crit",
        "points"
      ],
      "assumptions": [
        "In-plane eccentric load: uniform direct shear from the load components plus torsional shear from the torque T about the weld-group centroid; the resultant is the vector sum evaluated at every weld endpoint (the critical point has the largest resultant). Out-of-plane bending loads are a separate case not covered here.",
        "Equal-leg 45\u00b0 fillets; every stress scales as 1/(0.707 h), so the critical point does not depend on the leg size."
      ],
      "method_references": [
        "Direct + torsional shear vector sum at weld-group endpoints (Shigley sec. 9-2 form, recalled)"
      ],
